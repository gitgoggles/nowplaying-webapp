@page "/config"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using nowplaying_webapp.Models
@rendermode InteractiveServer
@inject nowplaying_webapp.Models.AppDbContext Db
@inject nowplaying_webapp.Services.ConfigStore config

<h1>Config</h1>
<EditForm class="config-form" Model="@_Config" OnValidSubmit="SaveAsync">
	<DataAnnotationsValidator />
	<ValidationSummary />

	<div class="config-section">
		<h2>Demo Data</h2>
		<div class="config-section-inline">
			<label>Demo Data Enabled</label>
			<InputCheckbox @bind-Value="_Config.DemoDataEnabled" />
			<NowPlayingCard FetcherName="Demo" Variant="Full" />
		</div>
	</div>

	<hr>

	<div class="config-section">
		<h2>Jellyfin</h2>
		<label>URL</label>
		<InputText @bind-Value="_Config.JellyfinUrl" />
		<label>API Key</label>
		<InputText type="password" @bind-Value="_Config.JellyfinApi" />
		<div class="config-section-inline">
			<label>Enabled</label>
			<InputCheckbox @bind-Value="_Config.JellyfinEnabled" />
			<NowPlayingCard FetcherName="jellyfin" Variant="Full" />
		</div>
	</div>

	<hr>

	<div class="config-section">
		<h2>Plex</h2>
		<label>URL</label>
		<InputText @bind-Value="_Config.PlexUrl" />
		<label>API Key</label>
		<InputText type="password" @bind-Value="_Config.PlexApi" />
		<div class="config-section-inline">
			<label>Enabled</label>
			<InputCheckbox @bind-Value="_Config.PlexEnabled" />
			<NowPlayingCard FetcherName="Plex" Variant="Full" />
		</div>
	</div>

	<hr>

	<div class="button-right">
		<button type="submit">Save</button>
	</div>
</EditForm>

@code {
	public required ConfigModel _Config;

	protected override async Task OnInitializedAsync()
	{
		var existing_config = await Db.Configs.FirstOrDefaultAsync();
		_Config = existing_config ?? new ConfigModel();

		if (existing_config is null)
		{
			Db.Configs.Add(_Config);
			await Db.SaveChangesAsync();
		}
	}

	private async Task SaveAsync()
	{
		await Db.SaveChangesAsync();
		await config.RefreshAsync();
	}
}
