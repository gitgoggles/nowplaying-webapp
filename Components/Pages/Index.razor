@page "/"
@inject nowplaying_webapp.Services.ConfigStore config
@rendermode InteractiveServer

<header>
	<h1>What is <i>playing</i> right now?</h1>
	<aside>Hopefully I can populate this with the currently playing song from Plex, Jellyfin or Mixxx.</aside>
</header>
<a href="/config">Config2</a>
<div>is demo data enabled? @config.Store?.DemoDataEnabled </div>

<NowPlayingCard />

@code {
	protected override void OnInitialized()
	{
		config.ConfigUpdated += OnConfigChanged;
	}
	private void OnConfigChanged()
	{
		_ = InvokeAsync(StateHasChanged);
	}
	private void Dispose()
	{
		config.ConfigUpdated -= OnConfigChanged;
	}
}
