@code {
	[Parameter]
	public string FetcherName { get; set; } = "jellyfin";
}

<NowPlayingWatcher FetcherName="@FetcherName">
	<ChildContent Context="nowPlaying">
		@if (nowPlaying?.ArtistAndTitleAcquired == true)
		{
			<div id="card">
				<div id="title" class="sliide">@nowPlaying.Title</div>
				<div id="artist" class="sliide">@nowPlaying.Artist</div>
			</div>
		}
		else if (!string.IsNullOrWhiteSpace(nowPlaying?.Full))
		{
			<div id="card">
				<div id="title">@nowPlaying.Full</div>
			</div>
		}
	</ChildContent>
</NowPlayingWatcher>
