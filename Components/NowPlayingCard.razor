<NowPlayingWatcher FetcherName="@FetcherName">
	<ChildContent>
		@if (context?.ArtistAndTitleAcquired == true)
		{
			<div id="card">
				<div id="title">@context.Title</div>
				<div id="artist">@context.Artist</div>
			</div>
		}
		else if (!string.IsNullOrWhiteSpace(context?.Full))
		{
			<div id="card">
				<div id="title">@context.Full</div>
			</div>
		}
	</ChildContent>
</NowPlayingWatcher>

@code {
	[Parameter]
	public string FetcherName { get; set; } = "jellyfin";
}
