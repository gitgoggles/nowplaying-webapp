@using nowplaying_webapp.Models
@using nowplaying_webapp.Services
@implements IDisposable
@inject NowPlayingStore Store

@switch (Variant)
{
	case "Full":
		<div @key="_nowPlaying" class="@ExtraClass @(_isExiting ? "exiting" : null)">
			<div id="full">@_nowPlaying?.Full</div>
		</div>
		break;

	case "Artist":
		<div @key="_nowPlaying" class="@ExtraClass @(_isExiting ? "exiting" : null)">
			<div id="artist">@_nowPlaying?.Artist</div>
		</div>
		break;

	case "Title":
		<div @key="_nowPlaying" class="@ExtraClass @(_isExiting ? "exiting" : null)">
			<div id="title">@_nowPlaying?.Title</div>
		</div>
		break;

	default:
		@if (_nowPlaying?.ArtistAndTitleAcquired == true)
		{
			<div @key="_nowPlaying" class="@ExtraClass @(_isExiting ? "exiting" : null)">
				<div id="title">@_nowPlaying.Title</div>
				<div id="artist">@_nowPlaying.Artist</div>
			</div>
		}
		else if (!string.IsNullOrWhiteSpace(_nowPlaying?.Full))
		{
			<div @key="_nowPlaying" class="@ExtraClass @(_isExiting ? "exiting" : null)">
				<div id="title">@_nowPlaying.Full</div>
			</div>
		}
		break;
}

@code {
	[Parameter]
	public string? FetcherName { get; set; }

	[Parameter]
	public string? Variant { get; set; }

	[Parameter]
	public string? ExtraClass { get; set; }

	private NowPlaying? _nowPlaying;
	private bool _isExiting = false;

	protected override void OnInitialized()
	{
		_nowPlaying = Store.Get(FetcherName);
		Store.StoreUpdated += OnStoreUpdated;
	}

	private void OnStoreUpdated(string fetcherName, NowPlaying? nowPlaying)
	{
		_ = UpdateCardData(fetcherName, nowPlaying);
	}

	private async Task UpdateCardData(string fetcherName, NowPlaying? nowPlaying)
	{
		await InvokeAsync(() =>
		{
			_isExiting = true;
			StateHasChanged();
		});

		await Task.Delay(1000);

		await InvokeAsync(() =>
		{
			_nowPlaying = Store.Get(FetcherName);
			_isExiting = false;
			StateHasChanged();
		});
	}

	public void Dispose()
	{
		Store.StoreUpdated -= OnStoreUpdated;
	}
}
