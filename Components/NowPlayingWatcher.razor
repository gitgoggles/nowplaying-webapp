@inject FetcherRegistry Fetchers

@ChildContent(_nowPlaying)

@code {
	[Parameter]
	public string FetcherName { get; set; } = string.Empty;

	[Parameter]
	public RenderFragment<NowPlaying?> ChildContent { get; set; } = default!;

	private NowPlaying? _nowPlaying;
	private (string? Artist, string? Title, string? Full)? _snapshot;
	private CancellationTokenSource? _cts;

	protected override void OnInitialized()
	{
		_cts = new CancellationTokenSource();
		_ = PollAsync(_cts.Token);
	}

	private async Task PollAsync(CancellationToken ct)
	{
		var fetcher = Fetchers.GetFetcher(FetcherName);
		if (fetcher is null)
		{
			return;
		}

		using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));

		try
		{
			while (await timer.WaitForNextTickAsync(ct))
			{
				var next = await fetcher.GetNowPlayingAsync(ct);
				var nextSnapshot = (next?.Artist, next?.Title, next?.Full);

				if (_snapshot != nextSnapshot)
				{
					_nowPlaying = next;
					_snapshot = nextSnapshot;
					await InvokeAsync(StateHasChanged);
				}
			}
		}
		catch (OperationCanceledException)
		{
		}
	}

	public void Dispose()
	{
		_cts?.Cancel();
		_cts?.Dispose();
	}
}
